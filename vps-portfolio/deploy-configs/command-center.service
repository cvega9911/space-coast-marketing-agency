[Unit]
Description=Dojo Command Center Flask App
After=network.target

[Service]
User=jarvis
WorkingDirectory=/home/jarvis/command-center
EnvironmentFile=/home/jarvis/command-center/.env
ExecStart=/home/jarvis/.agent-reach-venv/bin/python3 /home/jarvis/command-center/app.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target