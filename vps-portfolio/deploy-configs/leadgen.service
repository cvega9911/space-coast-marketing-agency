[Unit]
Description=Presencify Leadgen — Outreach tool (Flask)
After=network.target

[Service]
Type=simple
User=jarvis
WorkingDirectory=/home/jarvis/presencify/leadgen
EnvironmentFile=/home/jarvis/presencify/leadgen/.env
ExecStart=/home/jarvis/.agent-reach-venv/bin/python3 /home/jarvis/presencify/leadgen/app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target